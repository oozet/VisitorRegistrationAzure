{
    "version": "2.0",
    "logging": {
        "logLevels": {
            "default": "Information"
        },
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "maxTelemetryItemsPerSecond" : 5,
                "excludedTypes": "Dependency;Event",
                "includedTypes" : "PageView;Trace"
            },
            "enableLiveMetricsFilters": true
        }
    }
}